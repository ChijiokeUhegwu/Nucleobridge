# ==============================================================================
# NUCLEOBRIDGE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Note: In accordance with AGENTS.md, all keys, tokens, and database credentials
# reside exclusively on the server and must never be exposed to the browser.
# ==============================================================================

# Database Connections
# DATABASE_URL: Pooled connection string used by the Next.js runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/nucleobridge?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL: Direct unpooled connection string required by Prisma for migrations.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/nucleobridge"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Flutterwave Payment Gateway (Naira transactions only)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx"
FLUTTERWAVE_WEBHOOK_HASH="replace-with-your-secret-webhook-hash"

# AI Mentor Multi-Tier Providers (Server-only keys)
FREE_MODEL_API_KEY="replace-with-free-model-provider-key"
PAID_MODEL_API_KEY="replace-with-paid-model-provider-key"
EMBEDDING_MODEL_API_KEY="replace-with-768-dim-embedding-provider-key"

# Private Object Storage (Datasets)
DATASET_STORAGE_URL="https://storage.nucleobridge.internal"
DATASET_STORAGE_SECRET_KEY="replace-with-dataset-storage-secret"

# Email Delivery (One-time 6-digit login codes)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="NucleoBridge <noreply@nucleobridge.org>"

# System Operations & Scheduled Jobs
RECONCILE_JOB_SECRET="replace-with-scheduler-bearer-secret"
SIGNUPS_ENABLED="true"

